{
  "description": "Rishi's numerical simulations. Illustrative parameters from Joel's Section 2 (1.8), NOT fitted to data.",
  "model": "dH/dt = rH(1-H/K) - aHP/(b+H);  dP/dt = eaHP/(b+H) - mP  (shared src/lynx_hare/model.py)",
  "units": {
    "H, P": "thousand pelts (abundance index)",
    "t": "years",
    "r": "1/year", "K": "thousand pelts", "a": "hare / (lynx * year)",
    "b": "thousand pelts", "e": "lynx / hare", "m": "1/year"
  },
  "params": {"r": 1.5, "a": 4.0, "b": 30.0, "e": 0.4, "m": 0.8},
  "bifurcation_parameter": "K",
  "regimes_K": {"A": 25.0, "B": 60.0, "C": 85.0, "D": 90.0, "E": 95.0, "F": 150.0},
  "solver": {"method": "RK45", "rtol": 1e-10, "atol": 1e-12},
  "initial_state": [20.0, 5.0],
  "burn_in_years": 3000.0,
  "burn_in_years_near_hopf": 20000.0,
  "near_hopf_window": 1.0,
  "bifurcation_sweep": {"K_min": 32.0, "K_max": 200.0, "points": 113, "record_years": 300.0},
  "amplitude_law": {"dK_min": 0.5, "dK_max": 8.0, "points": 12, "record_years": 400.0}
}
